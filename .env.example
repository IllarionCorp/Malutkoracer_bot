# Получи токен у https://t.me/BotFather и впиши его только в .env.
BOT_TOKEN=
TRACK_NAME=Гоночный трек
TIMEZONE=Europe/Moscow

# Числовые Telegram ID администраторов через запятую. Узнать свой ID: /id.
ADMIN_IDS=
# PostgreSQL: база должна существовать; таблицы создаются при запуске бота.
DATABASE_URL=postgresql://booking_bot:booking_bot@localhost:5432/booking_bot

# Бронирование на целое число часов. Расписание и цену добавляет администратор.
MAX_BOOKING_HOURS=24
BOOKING_DAYS=365
MIN_NOTICE_MINUTES=0

